{
  "manifest_version": 3,
  "name": "Device Studio Speakers",
  "version": "1.0.0",
  "description": "Tells Device Studio on this Mac who is speaking on a Google Meet call, so your local transcript shows names.",
  "key": "",
  "permissions": ["nativeMessaging"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_title": "Device Studio Speakers", "default_popup": "popup.html" }
}
